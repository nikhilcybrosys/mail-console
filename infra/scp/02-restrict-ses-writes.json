{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SesWritesOnlyFromConsoleWriteRolesOrTerraform",
      "Effect": "Deny",
      "Action": [
        "ses:Create*",
        "ses:Delete*",
        "ses:Put*",
        "ses:Update*",
        "ses:Verify*",
        "ses:Set*",
        "ses:StartArchiveExport"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/mc-*-console-write-ops",
            "arn:aws:iam::*:role/mc-*-console-write-security",
            "arn:aws:iam::*:role/terraform-admin",
            "arn:aws:iam::*:role/mc-*-mailmanager-rule-actions",
            "arn:aws:iam::*:role/aws-service-role/*"
          ]
        }
      }
    }
  ]
}
