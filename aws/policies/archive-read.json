{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTheMailArchive",
      "Effect": "Allow",
      "Action": [
        "ses:GetArchive", "ses:GetArchiveMessage",
        "ses:StartArchiveSearch",
        "ses:GetArchiveSearch",
        "ses:GetArchiveSearchResults",
        "ses:GetArchiveMessageContent"
      ],
      "Resource": "__ARCHIVE_ARN__"
    },
    {
      "Sid": "DecryptTheMailArchive",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": "__ARCHIVE_KMS_KEY_ARN__",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ses.__REGION__.amazonaws.com",
          "kms:CallerAccount": "__ACCOUNT_ID__"
        }
      }
    }
  ]
}
