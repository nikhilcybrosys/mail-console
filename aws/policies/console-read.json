{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SesReadOnly",
      "Effect": "Allow",
      "Action": [
        "ses:GetAccount", "ses:ListEmailIdentities", "ses:GetEmailIdentity", "ses:ListConfigurationSets", "ses:GetConfigurationSet",
        "ses:GetConfigurationSetEventDestinations", "ses:ListSuppressedDestinations", "ses:GetSuppressedDestination", "ses:GetMessageInsights"
      ],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "__REGION__"}}
    },
    {
      "Sid": "ReputationMetricsRead",
      "Effect": "Allow",
      "Action": ["cloudwatch:GetMetricData"],
      "Resource": "*"
    },
    {
      "Sid": "EventQueueConsume",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:ChangeMessageVisibility", "sqs:GetQueueAttributes", "sqs:GetQueueUrl"],
      "Resource": "__QUEUE_ARN__"
    },
    {
      "Sid": "AssumeTheTwoWriteRoles",
      "Effect": "Allow",
      "Action": ["sts:AssumeRole", "sts:SetSourceIdentity"],
      "Resource": [
        "arn:aws:iam::__ACCOUNT_ID__:role/mail-console-write-ops",
        "arn:aws:iam::__ACCOUNT_ID__:role/mail-console-write-security"
      ]
    },
    {
      "Sid": "NeverSendMail",
      "Effect": "Deny",
      "Action": ["ses:SendEmail", "ses:SendBulkEmail", "ses:SendRawEmail", "ses:SendCustomVerificationEmail", "ses:SendTemplatedEmail", "ses:SendBulkTemplatedEmail", "ses:SendBounce", "ses:Send*"],
      "Resource": "*"
    }
  ]
}
