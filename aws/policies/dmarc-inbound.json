{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DmarcQueueConsume",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Resource": "__DMARC_QUEUE_ARN__"
    },
    {
      "Sid": "ReadReportMailOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::__DMARC_BUCKET__/__DMARC_PREFIX__*"
    }
  ]
}
