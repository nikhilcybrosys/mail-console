{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SuppressionListEdits",
      "Effect": "Allow",
      "Action": ["ses:PutSuppressedDestination", "ses:DeleteSuppressedDestination"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "__REGION__",
          "aws:SourceIdentity": "__ALLOWED_EMAILS__"
        }
      }
    },
    {
      "Sid": "NeverSendMail",
      "Effect": "Deny",
      "Action": ["ses:SendEmail", "ses:SendBulkEmail", "ses:SendRawEmail", "ses:SendCustomVerificationEmail", "ses:SendTemplatedEmail", "ses:SendBulkTemplatedEmail", "ses:SendBounce", "ses:Send*"],
      "Resource": "*"
    }
  ]
}
