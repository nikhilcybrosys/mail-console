{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendOneMailFromAnAllowedAddressAsANamedPerson",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "__SEND_RESOURCES__",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "__REGION__",
          "aws:SourceIdentity": "__SEND_EMAILS__",
          "ses:FromAddress": "__SEND_FROM__"
        }
      }
    },
    {
      "Sid": "NoOtherSendActions",
      "Effect": "Deny",
      "Action": [
        "ses:SendBulkEmail",
        "ses:SendRawEmail",
        "ses:SendCustomVerificationEmail",
        "ses:SendTemplatedEmail",
        "ses:SendBulkTemplatedEmail",
        "ses:SendBounce"
      ],
      "Resource": "*"
    }
  ]
}
