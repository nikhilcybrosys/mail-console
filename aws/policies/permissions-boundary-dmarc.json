{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CeilingNotAGrant",
      "Effect": "Allow",
      "Action": [
        "ses:*",
        "sqs:*",
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics",
        "sts:AssumeRole",
        "sts:SetSourceIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DmarcReportMailReadCeiling",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::__DMARC_BUCKET__/__DMARC_PREFIX__*"
    },
    {
      "Sid": "NoConsoleRoleCanEverSendMail",
      "Effect": "Deny",
      "Action": [
        "ses:SendEmail",
        "ses:SendBulkEmail",
        "ses:SendRawEmail",
        "ses:SendCustomVerificationEmail",
        "ses:SendTemplatedEmail",
        "ses:SendBulkTemplatedEmail",
        "ses:SendBounce",
        "ses:Send*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SesOnlyInTheConfiguredRegion",
      "Effect": "Deny",
      "Action": "ses:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "__REGION__"
        }
      }
    },
    {
      "Sid": "NoSelfEscalation",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary",
        "iam:CreateRole",
        "iam:CreateUser",
        "iam:CreateAccessKey",
        "iam:AttachRolePolicy",
        "iam:PutRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "iam:CreatePolicyVersion"
      ],
      "Resource": "*"
    }
  ]
}
