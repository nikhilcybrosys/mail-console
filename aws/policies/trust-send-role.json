{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowWithTheSharedSecret",
      "Effect": "Allow",
      "Principal": {
        "AWS": "__APP_ROLE_ARN__"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "__EXTERNAL_ID__"
        }
      }
    },
    {
      "Sid": "AllowNamingAnAllowedSender",
      "Effect": "Allow",
      "Principal": {
        "AWS": "__APP_ROLE_ARN__"
      },
      "Action": "sts:SetSourceIdentity",
      "Condition": {
        "StringEquals": {
          "sts:SourceIdentity": "__SEND_EMAILS__"
        }
      }
    },
    {
      "Sid": "RefuseAnyoneButAnAllowedSender",
      "Effect": "Deny",
      "Principal": {
        "AWS": "__APP_ROLE_ARN__"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:SetSourceIdentity"
      ],
      "Condition": {
        "StringNotEquals": {
          "sts:SourceIdentity": "__SEND_EMAILS__"
        }
      }
    }
  ]
}
